{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": false,
    "outDir": "../../node_modules/.cache/typescript/build/extension",
    "rootDir": "src",
    "tsBuildInfoFile": "../../node_modules/.cache/typescript/extension.tsbuildinfo",
    "types": ["chrome"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.test-d.ts"],
  "references": [
    { "path": "../../packages/shared-types/tsconfig.json" },
    { "path": "../../packages/detectors/tsconfig.json" },
    { "path": "../../packages/policy-engine/tsconfig.json" }
  ]
}
