{
  "name": "ai-dlp-browser-extension",
  "version": "0.0.0",
  "private": true,
  "description": "Privacy-first local data loss prevention for ChatGPT prompts.",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": "10.13.1"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --build --pretty false",
    "test:unit": "vitest run --project unit --project node --project dom",
    "test:browser": "pnpm build && playwright test",
    "test:performance": "vitest run --project performance --disableConsoleIntercept",
    "test": "pnpm test:unit",
    "build": "pnpm --filter @ai-dlp/extension build",
    "verify:artifact": "node scripts/verify-production-artifact.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/chrome": "0.2.2",
    "@types/node": "22.15.34",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
